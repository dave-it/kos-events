<div class="mx-auto max-w-3xl space-y-5 px-4 py-6">
  <header class="flex items-center gap-4">
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-signal font-display text-3xl"><%= @rider.firstname.first %><%= @rider.lastname.first %></span>
    <div>
      <h1 class="font-display text-4xl uppercase leading-none"><%= @rider.name %></h1>
      <p class="mt-1 text-sm text-white/60"><%= current_user.email_address %></p>
    </div>
  </header>

  <section class="card">
    <div class="flex items-center justify-between">
      <h2 class="eyebrow"><%= t(".details") %></h2>
      <%= link_to t(".edit"), edit_hub_path, class: "text-sm font-semibold text-signal underline underline-offset-4" %>
    </div>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
      <dt class="text-white/50"><%= t(".name") %></dt><dd><%= @rider.name %></dd>
      <dt class="text-white/50"><%= t(".nickname") %></dt><dd><%= @rider.nickname.presence || "–" %></dd>
      <dt class="text-white/50"><%= t(".nation") %></dt><dd><%= @rider.nation.presence || "–" %></dd>
      <dt class="text-white/50"><%= t(".birthday") %></dt><dd><%= @rider.birthday ? l(@rider.birthday) : "–" %></dd>
      <dt class="text-white/50"><%= t(".organization") %></dt><dd><%= @rider.organization.presence || "–" %></dd>
      <dt class="text-white/50"><%= t(".public_profile") %></dt><dd><%= @rider.public_profile? ? t("shared.yes") : t("shared.no") %></dd>
    </dl>
  </section>

  <%= render "shared/install" %>

  <section class="card flex items-center justify-between">
    <h2 class="eyebrow"><%= t("shared.language") %></h2>
    <%= render "shared/locale_switcher" %>
  </section>

  <nav class="flex justify-center gap-5 text-sm text-white/60" aria-label="<%= t("auth.legal") %>">
    <% Page.published.where(slug: %w[impressum datenschutz cookies]).order(:position).each do |page| %>
      <%= link_to page.title, content_page_path(page.slug), class: "underline underline-offset-4 hover:text-white" %>
    <% end %>
  </nav>

  <%= button_to t("shared.sign_out"), session_path, method: :delete, class: "btn-ghost w-full", form_class: "block" %>
</div>
