<h1 class="font-bold text-3xl"><%= t(".title") %></h1>
<p class="mt-2 text-gray-600"><%= t(".greeting", name: @rider.nickname.presence || @rider.firstname) %></p>

<section class="mt-8 bg-white rounded-lg border border-gray-200 p-5">
  <div class="flex items-center justify-between">
    <h2 class="font-semibold text-lg"><%= t(".profile") %></h2>
    <%= link_to t(".edit"), edit_hub_path, class: "text-blue-600 underline hover:no-underline" %>
  </div>
  <dl class="mt-4 grid grid-cols-2 gap-y-2 text-sm">
    <dt class="text-gray-500"><%= t(".name") %></dt><dd><%= @rider.name %></dd>
    <dt class="text-gray-500"><%= t(".nickname") %></dt><dd><%= @rider.nickname.presence || "–" %></dd>
    <dt class="text-gray-500"><%= t(".nation") %></dt><dd><%= @rider.nation.presence || "–" %></dd>
    <dt class="text-gray-500"><%= t(".birthday") %></dt><dd><%= @rider.birthday ? l(@rider.birthday) : "–" %></dd>
    <dt class="text-gray-500"><%= t(".organization") %></dt><dd><%= @rider.organization.presence || "–" %></dd>
    <dt class="text-gray-500"><%= t(".public_profile") %></dt><dd><%= @rider.public_profile? ? t("shared.yes") : t("shared.no") %></dd>
  </dl>
</section>

<section class="mt-6 bg-white rounded-lg border border-gray-200 p-5">
  <h2 class="font-semibold text-lg"><%= t(".my_events") %></h2>
  <% if @registrations.empty? %>
    <p class="mt-2 text-sm text-gray-500"><%= t(".no_registrations") %></p>
  <% else %>
    <ul class="mt-3 divide-y divide-gray-100 text-sm">
      <% @registrations.each do |reg| %>
        <li class="py-2 flex items-center justify-between">
          <span>
            <strong><%= reg.event.name %></strong>
            <span class="text-gray-500">· <%= l reg.event.starts_at.to_date %> · <%= reg.category.name %></span>
          </span>
          <span class="text-gray-600">
            <%= reg.start_number ? t(".number", number: reg.start_number) : t(".number_open") %>
            <%= " · #{t(".checked_in")}" if reg.checked_in? %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
