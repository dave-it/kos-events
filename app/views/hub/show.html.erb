<div class="mx-auto max-w-3xl space-y-5 px-4 py-6">
  <header>
    <p class="eyebrow"><%= t(".title") %></p>
    <h1 class="mt-1 font-display text-5xl uppercase leading-none"><%= t(".greeting", name: @rider.nickname.presence || @rider.firstname) %></h1>
  </header>

  <% if @next_event %>
    <% days = [ (@next_event.starts_at.to_date - Date.current).to_i, 0 ].max %>
    <section class="overflow-hidden rounded-2xl bg-signal">
      <div class="flex items-start justify-between gap-4 p-5">
        <div>
          <p class="eyebrow text-white/80"><%= t(".next_event") %></p>
          <h2 class="mt-1 font-display text-4xl uppercase leading-none"><%= @next_event.name %></h2>
          <p class="mt-2 text-sm text-white/90"><%= l @next_event.starts_at.to_date, format: :long %><%= " · #{@next_event.location}" if @next_event.location.present? %></p>
        </div>
        <div class="text-center leading-none">
          <div class="font-display text-6xl"><%= days %></div>
          <div class="text-xs font-semibold uppercase"><%= t(".days", count: days) %></div>
        </div>
      </div>
      <div class="bg-black/20 p-5">
        <% if @next_registrations.any? %>
          <ul class="space-y-3">
            <% @next_registrations.each do |reg| %>
              <li class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-semibold"><%= reg.category.name %> · <%= reg.start_number ? t(".number", number: reg.start_number) : t(".number_open") %></span>
                <span class="flex gap-2 text-xs font-semibold">
                  <span class="rounded-full px-2.5 py-1 <%= reg.waiver_signed? ? 'bg-white text-ink' : 'border border-white/60' %>"><%= reg.waiver_signed? ? t(".waiver_done") : t(".waiver_open") %></span>
                  <span class="rounded-full px-2.5 py-1 <%= reg.checked_in? ? 'bg-white text-ink' : 'border border-white/60' %>"><%= reg.checked_in? ? t(".checked_in") : t(".check_in_open") %></span>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="font-semibold"><%= t(".not_registered") %></p>
          <% if @next_event.registration_open? %>
            <%= link_to t("events.show.register"), safe_external_url(@next_event.registration_url), class: "mt-3 inline-block rounded-xl bg-white px-5 py-2.5 font-semibold text-ink", rel: "noopener", target: "_blank" %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% [ [ :calendar, t(".tiles.schedule"), info_path(anchor: "schedule") ], [ :help, t(".tiles.questions"), info_path ],
         [ :chat, t(".tiles.chat"), chat_rooms_path ], [ :trophy, t(".tiles.results"), events_path ] ].each do |icon, label, path| %>
      <li>
        <%= link_to path, class: "card flex h-full flex-col gap-3 hover:bg-white/10" do %>
          <span class="text-signal"><%= app_icon icon, "h-7 w-7" %></span><span class="font-semibold leading-tight"><%= label %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <section class="card">
    <div class="flex items-center justify-between">
      <h2 class="eyebrow"><%= t(".announcements") %></h2>
      <%= link_to t(".all"), chat_rooms_path, class: "text-sm text-white/60 underline underline-offset-4" %>
    </div>
    <% if @announcements.empty? %>
      <p class="mt-3 text-sm text-white/60"><%= t(".no_announcements") %></p>
    <% else %>
      <ul class="mt-2 divide-y divide-white/10">
        <% @announcements.each do |message| %>
          <li>
            <%= link_to chat_room_path(message.chat_room), class: "block py-3" do %>
              <span class="text-xs text-white/50"><%= message.chat_room.name %> · <%= l message.created_at, format: "%d.%m. %H:%M" %></span>
              <span class="mt-0.5 line-clamp-2 block"><%= message.body %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card">
    <h2 class="eyebrow"><%= t(".my_events") %></h2>
    <% if @registrations.empty? %>
      <p class="mt-3 text-sm text-white/60"><%= t(".no_registrations") %></p>
    <% else %>
      <ul class="mt-2 divide-y divide-white/10">
        <% @registrations.each do |reg| %>
          <li class="flex items-center justify-between gap-3 py-3">
            <span>
              <strong class="block"><%= reg.event.published? ? link_to(reg.event.name, event_path(reg.event, category: reg.category_id), class: "hover:underline") : reg.event.name %></strong>
              <span class="text-sm text-white/50"><%= l reg.event.starts_at.to_date %> · <%= reg.category.name %></span>
            </span>
            <span class="shrink-0 text-sm text-white/70"><%= reg.start_number ? t(".number", number: reg.start_number) : t(".number_open") %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
