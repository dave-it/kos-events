<%# Hero %>
<section class="relative isolate overflow-hidden">
  <%= image_tag "landing/hero.jpg", alt: "Zwei Ice-Cross-Fahrer im Rennen bei Nacht", class: "absolute inset-0 -z-10 h-full w-full object-cover", fetchpriority: "high" %>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/50 to-ink/20"></div>

  <div class="mx-auto max-w-7xl px-5 pt-40 pb-16 md:pt-56">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-white/70">Ice Cross Austria</p>
    <h1 class="mt-4 max-w-4xl font-display text-6xl leading-[0.95] uppercase sm:text-7xl md:text-8xl">
      Mach mit beim schnellsten Sport auf Eislaufschuhen
    </h1>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#mitmachen" class="rounded bg-signal hover:bg-signal-dark px-6 py-3 font-semibold">Ich will mitfahren</a>
      <a href="#sport" class="rounded border border-white/40 hover:bg-white/10 px-6 py-3 font-semibold">Was ist Ice Cross?</a>
    </div>
  </div>
</section>

<%# Nächstes Event + Countdown %>
<section id="event" class="bg-signal scroll-mt-16">
  <div class="mx-auto max-w-7xl px-5 py-8 grid gap-6 md:grid-cols-[1fr_auto_auto] md:items-center">
    <% if @next_event %>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-white/80">Nächstes Event</p>
        <h2 class="mt-1 font-display text-4xl uppercase md:text-5xl"><%= @next_event.name %></h2>
        <p class="mt-1 text-white/90">
          <%= l @next_event.starts_at.to_date, format: :long %><%= " · #{@next_event.location}" if @next_event.location.present? %>
        </p>
      </div>
      <div data-controller="countdown" data-countdown-to-value="<%= @next_event.starts_at.iso8601 %>" class="flex gap-5" aria-label="Countdown bis zum Event">
        <% { days: "Tage", hours: "Std", minutes: "Min", seconds: "Sek" }.each do |key, label| %>
          <div class="text-center">
            <div data-countdown-target="<%= key %>" class="font-display text-5xl tabular-nums leading-none">00</div>
            <div class="mt-1 text-[0.65rem] font-semibold uppercase tracking-widest text-white/80"><%= label %></div>
          </div>
        <% end %>
      </div>
      <%= link_to "Zum Fahrer-Login", new_session_path, class: "rounded bg-ink hover:bg-ink-soft px-6 py-3 font-semibold text-center" %>
    <% else %>
      <div class="md:col-span-3">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-white/80">Nächstes Event</p>
        <h2 class="mt-1 font-display text-4xl uppercase md:text-5xl">Termine folgen</h2>
        <p class="mt-1 text-white/90">Sobald das nächste Event feststeht, findest du es hier.</p>
      </div>
    <% end %>
  </div>
</section>

<%# Zuschauen oder Mitfahren %>
<section id="mitmachen" class="mx-auto max-w-7xl px-5 py-20 scroll-mt-16">
  <p class="text-sm font-semibold uppercase tracking-[0.25em] text-signal">Wähle deine Seite</p>
  <h2 class="mt-2 font-display text-5xl uppercase md:text-6xl">Zuschauen oder mitfahren</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <article class="rounded-lg bg-ink-soft border border-white/10 p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-white/60">Fans · Familien · Besucher</p>
      <h3 class="mt-3 font-display text-5xl uppercase">Zuschauen</h3>
      <p class="mt-4 text-white/80">Erlebe die spektakulärsten Rennen auf Eis aus nächster Nähe. Vier Fahrer, ein Track, und die ersten zwei kommen weiter.</p>
      <a href="#event" class="mt-6 inline-block font-semibold text-signal hover:underline">Nächstes Event ansehen →</a>
    </article>
    <article class="rounded-lg bg-white text-ink p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-ink/60">Fahrer · alle Levels</p>
      <h3 class="mt-3 font-display text-5xl uppercase">Mitfahren</h3>
      <p class="mt-4 text-ink/80">Du willst Ice Cross ausprobieren oder beim Weltcup mitfahren? Fahrer bekommen ihren Zugang per Einladung und verwalten ihr Profil und ihre Anmeldungen im Rider Hub.</p>
      <%= link_to "Zum Fahrer-Login →", new_session_path, class: "mt-6 inline-block rounded bg-signal hover:bg-signal-dark px-5 py-3 font-semibold text-white" %>
    </article>
  </div>
</section>

<%# Der Sport %>
<section id="sport" class="bg-ink-soft scroll-mt-16">
  <div class="mx-auto max-w-7xl px-5 py-20 grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-signal">Neu bei Ice Cross?</p>
      <h2 class="mt-2 font-display text-5xl uppercase md:text-6xl">Vier Fahrer. Eine Eisbahn.</h2>
      <p class="mt-5 text-white/80 max-w-xl">Beim Ice Cross rasen Fahrer auf Schlittschuhen Seite an Seite durch Kurven, Sprünge und Wellen. Kurz, laut und leicht zu verstehen, auch beim ersten Mal.</p>
      <ol class="mt-8 space-y-6">
        <% [ [ "01", "Start", "Vier Fahrer stehen nebeneinander am Startgate." ],
              [ "02", "Rennen", "Kurven, Sprünge und Wellen, dicht an dicht bis ins Ziel." ],
              [ "03", "Weiter", "Die ersten zwei jedes Heats kommen eine Runde weiter, bis zum Finale." ] ].each do |nr, title, text| %>
          <li class="flex gap-5">
            <span class="font-display text-4xl text-signal leading-none"><%= nr %></span>
            <div>
              <h3 class="font-display text-3xl uppercase leading-none"><%= title %></h3>
              <p class="mt-1 text-white/70"><%= text %></p>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
    <%= image_tag "landing/race-3.jpg", alt: "Fahrerinnen am Startgate", class: "w-full rounded-lg object-cover aspect-[4/3]", loading: "lazy" %>
  </div>
</section>

<%# Galerie %>
<section id="galerie" class="mx-auto max-w-7xl px-5 py-20 scroll-mt-16">
  <p class="text-sm font-semibold uppercase tracking-[0.25em] text-signal">Speed + Impact</p>
  <h2 class="mt-2 font-display text-5xl uppercase md:text-6xl">Race Day</h2>
  <div class="mt-10 grid gap-3 grid-cols-2 md:grid-cols-3">
    <% [ [ "start.jpg", "Dreikampf um die erste Kurve", "col-span-2 md:col-span-2 md:row-span-2" ],
         [ "track.jpg", "Fahrer in der Welle", "" ],
         [ "race-1.jpg", "Rennszene", "" ],
         [ "race-2.jpg", "Rennszene", "" ],
         [ "race-4.jpg", "Rennszene bei Nacht", "" ] ].each do |file, alt, span| %>
      <%= image_tag "landing/#{file}", alt: alt, loading: "lazy", class: "w-full h-full object-cover rounded-lg aspect-[4/3] #{span}" %>
    <% end %>
  </div>
</section>

<%# Ergebnisse und Profile (Platzhalter bis die Daten importiert sind) %>
<section class="border-t border-white/10 bg-ink-soft">
  <div class="mx-auto max-w-7xl px-5 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-signal">Bald hier</p>
    <h2 class="mt-2 font-display text-5xl uppercase md:text-6xl">Ergebnisse und Fahrerprofile</h2>
    <p class="mx-auto mt-4 max-w-2xl text-white/70">Alle Rennergebnisse und die Profile der Fahrer findest du in Kürze auf dieser Seite.</p>
  </div>
</section>
