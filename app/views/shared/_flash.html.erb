<% if alert.present? %>
  <div class="mb-5 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 font-medium text-red-500" id="alert" role="alert"><%= alert %></div>
<% end %>
<% if notice.present? %>
  <div class="mb-5 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 font-medium text-green-600" id="notice" role="status"><%= notice %></div>
<% end %>
