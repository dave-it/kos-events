<section class="card hidden" data-controller="install">
  <h2 class="eyebrow"><%= t("app.install.title") %></h2>
  <p class="mt-2 text-sm text-white/70"><%= t("app.install.text") %></p>
  <button type="button" class="btn-primary mt-3 hidden w-full" data-install-target="button" data-action="install#prompt">
    <%= app_icon :download, "h-5 w-5" %><%= t("app.install.button") %>
  </button>
  <p class="mt-3 hidden rounded-xl bg-white/5 p-3 text-sm" data-install-target="ios"><%= t("app.install.ios") %></p>
</section>
