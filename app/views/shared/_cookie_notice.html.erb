<%# Reiner Hinweis ohne Auswahl: es gibt nur notwendige Cookies, also nichts zum Zustimmen. %>
<div class="fixed inset-x-0 bottom-0 z-50 hidden px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]" data-controller="notice" role="region" aria-label="<%= t("cookie_notice.label") %>">
  <div class="mx-auto flex max-w-3xl flex-col gap-3 rounded-2xl border border-white/15 bg-ink-soft p-4 text-sm text-white shadow-2xl sm:flex-row sm:items-center">
    <p class="flex-1 text-white/80"><%= t("cookie_notice.text") %>
      <a href="/cookies" class="underline underline-offset-4 hover:text-white"><%= t("cookie_notice.more") %></a></p>
    <button type="button" class="btn-primary !py-2" data-action="notice#dismiss"><%= t("cookie_notice.ok") %></button>
  </div>
</div>
