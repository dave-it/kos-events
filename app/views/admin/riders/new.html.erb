<h1 class="font-bold text-3xl">Fahrer einladen</h1>

<%= form_with model: @rider, url: admin_riders_path, class: "mt-5" do |form| %>
  <% if @rider.errors.any? %>
    <p class="py-2 px-3 bg-red-50 text-red-600 rounded-lg"><%= @rider.errors.full_messages.to_sentence %></p>
  <% end %>
  <% { firstname: "Vorname", lastname: "Nachname", nickname: "Nickname", nation: "Nation (z. B. DE)", organization: "Team / Organisation" }.each do |field, label| %>
    <div class="my-4">
      <%= form.label field, label, class: "text-sm text-gray-600" %>
      <%= form.text_field field, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>
  <div class="my-4">
    <%= form.label :email, "E-Mail (für die Einladung)", class: "text-sm text-gray-600" %>
    <%= form.email_field :email, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <%= form.submit "Anlegen und einladen", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <%= link_to "Abbrechen", admin_riders_path, class: "ml-3 underline" %>
<% end %>
