<div class="flex items-center justify-between">
  <h1 class="font-bold text-3xl"><%= t(".title") %></h1>
  <div class="flex items-center gap-3">
    <%= link_to t(".open_chat"), chat_rooms_path, class: "underline" %>
    <%= link_to t("admin.nav.events"), admin_events_path, class: "underline" %>
    <%= link_to t(".new"), new_admin_chat_room_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
</div>
<table class="mt-6 w-full bg-white rounded-lg border border-gray-200 text-sm">
  <thead class="text-left text-gray-500"><tr><th class="p-3"><%= t(".name") %></th><th class="p-3"><%= t(".audience") %></th><th class="p-3"><%= t(".writing") %></th><th class="p-3"></th></tr></thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr class="border-t border-gray-100">
        <td class="p-3"><%= link_to room.name, edit_admin_chat_room_path(room), class: "text-blue-600 underline" %></td>
        <td class="p-3"><%= room.audience.map { |r| t("admin.users.roles.#{r}") }.join(", ").presence || t(".organizers") %></td>
        <td class="p-3"><%= room.organizers_only? ? t(".organizers") : t(".everyone") %></td>
        <td class="p-3 text-right"><%= button_to t(".delete"), admin_chat_room_path(room), method: :delete, form: { data: { turbo_confirm: t(".confirm_delete", name: room.name) } }, class: "text-red-600 underline cursor-pointer" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
