<h1 class="font-bold text-3xl"><%= t(".title") %></h1>

<%= form_with model: @invitation, scope: :invitation, url: admin_users_path, class: "mt-5" do |form| %>
  <% if @invitation.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-600 rounded-lg"><%= @invitation.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="my-4">
    <%= form.label :email, t(".email"), class: "text-sm text-gray-600" %>
    <%= form.email_field :email, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <div class="my-4">
    <%= form.label :role, t(".role"), class: "text-sm text-gray-600" %>
    <%= form.select :role, Admin::UsersController::INVITABLE_ROLES.map { |r| [ t("admin.users.roles.#{r}"), r ] }, {}, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <div class="my-4">
    <%= form.label :locale, t(".locale"), class: "text-sm text-gray-600" %>
    <%= form.select :locale, available_locales.map { |l| [ t("shared.locale_names.#{l}"), l ] }, {}, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <%= link_to t("shared.cancel"), admin_users_path, class: "ml-3 underline" %>
<% end %>
