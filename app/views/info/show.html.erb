<% content_for(:title) { t(".title") } %>
<div class="mx-auto max-w-3xl px-4 pb-6" data-controller="filter">
  <div class="sticky top-[calc(3.5rem+env(safe-area-inset-top))] z-20 -mx-4 border-b border-white/10 bg-ink/95 px-4 pt-4 pb-3 backdrop-blur md:top-0">
    <h1 class="font-display text-4xl uppercase leading-none"><%= t(".title") %></h1>
    <div class="relative mt-3">
      <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-white/40"><%= app_icon :search, "h-5 w-5" %></span>
      <input type="search" class="field pl-11" placeholder="<%= t(".search") %>" aria-label="<%= t(".search") %>"
             data-filter-target="query" data-action="input->filter#apply">
    </div>
    <ul class="mt-3 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" aria-label="<%= t(".topics") %>">
      <% @topics.each do |topic| %>
        <li class="shrink-0" data-filter-target="chip" data-topic="<%= topic.key %>">
          <a href="#<%= topic.key %>" data-turbo="false" class="block rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold hover:bg-white/20"><%= topic.title %></a>
        </li>
      <% end %>
    </ul>
  </div>

  <p class="mt-8 hidden text-center text-white/60" data-filter-target="empty">
    <%= t(".no_results") %> <%= link_to t(".ask"), chat_rooms_path, class: "underline underline-offset-4" %>
  </p>

  <% schedule_key = @topics.find { |t| t.source && t.title.match?(/zeitplan|schedule/i) }&.key %>
  <% @topics.each do |topic| %>
    <section id="<%= topic.key %>" class="mt-8 scroll-mt-56" data-filter-target="topic" data-topic="<%= topic.key %>">
      <% if topic.key == schedule_key %><span id="schedule" class="block scroll-mt-56"></span><% end %>
      <% if topic.source %><p class="eyebrow"><%= topic.source %></p><% end %>
      <h2 class="font-display text-3xl uppercase"><%= topic.title %></h2>
      <div class="mt-3 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-ink-soft">
        <% topic.items.each do |item| %>
          <details class="group" data-filter-target="item" data-search="<%= "#{topic.title} #{item.group} #{item.title} #{item.body}".downcase %>">
            <summary class="flex cursor-pointer items-center justify-between gap-3 px-4 py-4 hover:bg-white/5">
              <span>
                <% if item.group && item.group != item.title %><span class="block text-xs text-white/50"><%= item.group %></span><% end %>
                <span class="font-semibold"><%= item.title %></span>
              </span>
              <span class="shrink-0 text-white/40 transition-transform group-open:rotate-90"><%= app_icon :chevron, "h-5 w-5" %></span>
            </summary>
            <div class="px-4 pb-5 text-[15px]"><%= markdown(item.body) %></div>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card mt-8">
    <h2 class="font-semibold"><%= t(".still_questions") %></h2>
    <p class="mt-1 text-sm text-white/70"><%= t(".still_text") %></p>
    <%= link_to t(".ask"), chat_rooms_path, class: "btn-primary mt-3" %>
  </section>
</div>
