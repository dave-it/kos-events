<% content_for(:title) { "#{t('.title')} – #{t('public.site_title')}" } %>
<h1 class="font-display text-5xl uppercase leading-none"><%= t(".title") %></h1>
<p class="mt-3 text-white/70"><%= t(".subtitle") %></p>

<ul class="mt-5 grid grid-cols-3 gap-2" aria-label="<%= t(".roles_label") %>">
  <% { "rider" => :flag, "helper" => :heart, "visitor" => :ticket }.each do |role, icon| %>
    <li class="flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-2 py-3 text-sm font-semibold">
      <span class="text-signal"><%= app_icon icon %></span><%= t(".roles.#{role}") %>
    </li>
  <% end %>
</ul>

<% unless Rails.configuration.x.login_open %>
  <p class="mt-5 rounded-xl border border-white/20 bg-white/10 px-4 py-3 font-semibold" role="status"><%= t(".closed") %></p>
<% end %>

<%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
  <div>
    <%= form.label :email_address, t(".email"), class: "mb-1.5 block text-sm text-white/70" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username", inputmode: "email", autocapitalize: "none", value: params[:email_address], class: "field" %>
  </div>
  <div data-controller="reveal">
    <div class="mb-1.5 flex items-baseline justify-between">
      <%= form.label :password, t(".password"), class: "text-sm text-white/70" %>
      <%= link_to t(".forgot"), new_password_path, class: "text-sm text-white/60 underline underline-offset-4 hover:text-white" %>
    </div>
    <div class="relative">
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field pr-12", data: { reveal_target: "input" } %>
      <button type="button" data-action="reveal#toggle" aria-label="<%= t(".show_password") %>" aria-pressed="false" data-reveal-target="button"
              class="absolute inset-y-0 right-0 px-3 text-white/50 cursor-pointer hover:text-white aria-pressed:text-signal"><%= app_icon :eye, "h-5 w-5" %></button>
    </div>
  </div>
  <%= form.submit t(".submit"), class: "btn-primary w-full text-lg" %>
<% end %>

<p class="mt-6 flex gap-3 text-sm text-white/60">
  <span class="text-white/40"><%= app_icon :lock, "h-5 w-5" %></span>
  <span><%= t(".invite_only") %> <a href="mailto:info@ice-cross.at" class="underline underline-offset-4 hover:text-white">info@ice-cross.at</a></span>
</p>
