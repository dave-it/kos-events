<h1 class="font-display text-5xl uppercase leading-none"><%= @invitation.rider ? t(".title", name: @invitation.rider.firstname) : t(".title_generic") %></h1>
<p class="mt-3 text-white/70"><%= t(@invitation.role == "rider" ? ".intro" : ".intro_#{@invitation.role}", email: @invitation.email) %></p>

<% if @error %>
  <div class="mt-5 rounded-xl bg-red-500/15 px-4 py-3 text-red-200"><%= @error %></div>
<% end %>

<%= form_with url: invitation_path(token: @invitation.token), method: :patch, class: "mt-6 space-y-4" do |form| %>
  <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: t(".password"), class: "field" %>
  <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: t(".confirmation"), class: "field" %>
  <%= form.submit t(".submit"), class: "btn-primary w-full text-lg" %>
<% end %>
