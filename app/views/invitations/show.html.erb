<h1 class="font-bold text-3xl"><%= @invitation.rider ? t(".title", name: @invitation.rider.firstname) : t(".title_generic") %></h1>
<p class="mt-2 text-gray-600"><%= t(@invitation.role == "rider" ? ".intro" : ".intro_#{@invitation.role}", email: @invitation.email) %></p>

<% if @error %>
  <div class="py-2 px-3 bg-red-50 mt-5 text-red-600 rounded-lg"><%= @error %></div>
<% end %>

<%= form_with url: invitation_path(token: @invitation.token), method: :patch, class: "mt-5" do |form| %>
  <div class="my-5">
    <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: t(".password"), class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <div class="my-5">
    <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: t(".confirmation"), class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
  <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
<% end %>
