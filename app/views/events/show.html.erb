<% content_for(:title) { "#{@event.name} – #{t('public.site_title')}" } %>
<div class="mx-auto max-w-7xl px-5 pt-12 pb-20">
  <%= link_to t("events.show.back"), events_path, class: "text-sm text-white/60 hover:text-white" %>
  <h1 class="mt-2 font-display text-5xl uppercase md:text-7xl"><%= @event.name %></h1>
  <p class="mt-2 text-white/70">
    <%= l @event.starts_at.to_date, format: :long %><%= " · #{@event.location}" if @event.location.present? %>
  </p>
  <% if @event.description.present? %><p class="mt-4 max-w-2xl text-white/80"><%= @event.description %></p><% end %>

  <% if @event.registration_open? %>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <%= link_to t(".register"), safe_external_url(@event.registration_url), class: "rounded bg-signal hover:bg-signal-dark px-6 py-3 font-semibold", rel: "noopener", target: "_blank" %>
      <% if @event.registration_deadline %><p class="text-sm text-white/70"><%= t(".register_until", date: l(@event.registration_deadline.in_time_zone, format: :long)) %></p><% end %>
    </div>
  <% end %>

  <% if @event.info.present? %>
    <div class="mt-10 max-w-3xl"><%= markdown(@event.info) %></div>
  <% end %>

  <% if @category.nil? %>
    <% if @event.info.blank? %><p class="mt-10 text-white/70"><%= t(".no_results") %></p><% end %>
  <% else %>
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="<%= t(".categories") %>">
      <% @categories.each do |cat| %>
        <%= link_to cat.name, event_path(@event, category: cat.id),
              class: "rounded-full px-4 py-1.5 text-sm font-semibold #{cat == @category ? 'bg-signal text-white' : 'bg-white/10 text-white/80 hover:bg-white/20'}",
              "aria-current": (cat == @category ? "page" : nil) %>
      <% end %>
    </nav>

    <%= render "legend" %>
    <%= render "bracket", bracket: @brackets[:main], medals: true, title: t(".main"), hint: t(".main_hint") %>
    <%= render "bracket", bracket: @brackets[:lcq], title: t(".lcq"), hint: t(".lcq_hint") %>
  <% end %>
</div>
