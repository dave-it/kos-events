<p class="mt-6 max-w-3xl text-sm text-white/60"><%= t("events.standings.hint") %></p>
<div class="mt-4 overflow-x-auto">
  <table class="w-full max-w-3xl text-left text-sm">
    <thead class="text-white/50">
      <tr>
        <th class="py-2 pr-3 font-semibold"><%= t("events.standings.rank") %></th>
        <th class="py-2 pr-3 font-semibold"><%= t("events.standings.name") %></th>
        <th class="py-2 pr-3 font-semibold"><%= t("events.standings.nation") %></th>
        <th class="py-2 pr-3 font-semibold"><%= t("events.standings.reached") %></th>
        <th class="py-2 font-semibold"><%= t("events.standings.trial") %></th>
      </tr>
    </thead>
    <tbody>
      <% standings.rows.each do |row| %>
        <% medal = { 1 => "bg-yellow-400 text-ink", 2 => "bg-gray-300 text-ink", 3 => "bg-amber-700 text-white" }[row.rank] %>
        <tr class="border-t border-white/10">
          <td class="py-2 pr-3">
            <span class="inline-flex h-7 min-w-7 items-center justify-center rounded-full px-1 font-bold <%= medal || 'text-white/70' %>"><%= row.rank %></span>
          </td>
          <td class="py-2 pr-3 <%= 'font-bold text-base' if row.rank <= 3 %>">
            <%= row.name %>
            <% if row.status %><span class="ml-1 rounded bg-white/15 px-1 text-[10px] font-bold"><%= row.status %></span><% end %>
          </td>
          <td class="py-2 pr-3 text-white/70"><%= row.nation %></td>
          <td class="py-2 pr-3 text-white/70">
            <%= case row.stage
                when :final then t("events.bracket.final")
                when :small_final then t("events.bracket.small_final")
                when :lcq then t("events.show.lcq")
                else t("events.bracket.rounds.number", number: row.round) end %>
          </td>
          <td class="py-2 text-white/70"><%= row.trial_rank ? t("events.bracket.trial_rank_short", rank: row.trial_rank) : "–" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
