<%# Heatbaum von links nach rechts. Erwartet: bracket (HeatBracket), title (String), hint (optional) %>
<% unless bracket.empty? %>
  <section class="mt-10" aria-label="<%= title %>">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="font-display text-3xl uppercase"><%= title %></h3>
      <% if local_assigns[:hint] %><p class="text-sm text-white/60"><%= hint %></p><% end %>
    </div>

    <div class="mt-4 overflow-x-auto rounded-lg border border-white/10 bg-ink-soft">
      <div class="relative" style="width: <%= bracket.width %>px; height: <%= bracket.height + 36 %>px;">
        <%# Spaltenköpfe %>
        <% bracket.columns.each_with_index do |col, i| %>
          <% name = bracket_round_name(col, i) %>
          <div class="absolute text-xs font-semibold uppercase tracking-[0.2em] text-white/60"
               style="left: <%= col.nodes.first.x %>px; top: 8px; width: <%= col.nodes.first.w %>px;"><%= name %></div>
        <% end %>

        <%# Verbindungslinien %>
        <svg class="absolute left-0" style="top: 36px;" width="<%= bracket.width %>" height="<%= bracket.height %>" aria-hidden="true">
          <% bracket.edges.each do |edge| %>
            <% x1 = edge.from.x + edge.from.w; y1 = edge.from.y + edge.from.h / 2; x2 = edge.to.x; y2 = edge.to.y + edge.to.h / 2; mid = (x2 - x1) / 2 %>
            <path d="M<%= x1 %>,<%= y1 %> C<%= x1 + mid %>,<%= y1 %> <%= x2 - mid %>,<%= y2 %> <%= x2 %>,<%= y2 %>"
                  fill="none" stroke-width="2"
                  stroke="<%= edge.kind == :advance ? "var(--color-signal)" : "rgba(255,255,255,0.25)" %>"
                  <%= 'stroke-dasharray="5 5"'.html_safe if edge.kind == :drop %>/>
          <% end %>
        </svg>

        <%# Heat-Karten %>
        <% bracket.columns.each do |col| %>
          <% big = col.kind == :final %>
          <% col.nodes.each do |node| %>
            <% medals = local_assigns[:medals] && node.role == :final %>
            <article class="absolute rounded-md border bg-ink shadow <%= big ? 'border-white/25 text-base' : 'border-white/15 text-sm' %>"
                     style="left: <%= node.x %>px; top: <%= node.y + 36 %>px; width: <%= node.w %>px; height: <%= node.h %>px;">
              <header class="flex items-center justify-between border-b border-white/10 px-3 py-1.5 font-semibold uppercase tracking-wider text-white/70 <%= big ? 'text-sm' : 'text-xs' %>">
                <span><%= bracket_heat_title(node) %></span>
              </header>
              <ol class="px-1.5 py-1 <%= 'space-y-1' if big %>">
                <% node.entries.each do |entry| %>
                  <% medal = medals && !entry.status && entry.place&.between?(1, 3) ? entry.place : nil %>
                  <li class="flex items-center gap-2 rounded px-1.5 <%= big ? 'py-2' : 'py-1' %> <%= entry.advanced? ? 'bg-signal/15 font-semibold' : 'text-white/60' %>">
                    <% if medal %>
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-display text-xl leading-none text-ink <%= { 1 => 'bg-[#e6b422]', 2 => 'bg-[#c4c9cf]', 3 => 'bg-[#cd7f32]' }[medal] %>"
                            title="<%= t("events.bracket.medal.#{%w[gold silver bronze][medal - 1]}") %>"><%= medal %></span>
                    <% else %>
                      <span class="w-4 shrink-0 text-center font-display leading-none <%= big ? 'text-xl' : 'text-lg' %> <%= 'text-signal' if entry.advanced? %>"><%= entry.status ? "" : (entry.place&.positive? ? entry.place : "–") %></span>
                    <% end %>
                    <span class="min-w-0 <%= big ? 'leading-tight' : 'truncate' %> <%= 'text-white' if medal %>"><%= entry.name %></span>
                    <% if entry.status %><span class="shrink-0 rounded bg-white/15 px-1 text-[10px] font-bold tracking-wider text-white" title="<%= t("events.bracket.status.#{entry.status.downcase}") %>"><%= entry.status %></span><% end %>
                    <span class="ml-auto flex shrink-0 items-center gap-1.5 whitespace-nowrap text-xs text-white/50">
                      <% if entry.nation.present? %><span><%= entry.nation %></span><% end %>
                      <% if entry.trial_rank %><span class="rounded bg-white/10 px-1 text-[10px] font-semibold text-white/70" title="<%= t("events.bracket.trial_rank", rank: entry.trial_rank) %>"><%= t("events.bracket.trial_rank_short", rank: entry.trial_rank) %></span><% end %>
                    </span>
                  </li>
                <% end %>
              </ol>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
