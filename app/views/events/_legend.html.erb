<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
  <li class="flex items-center gap-2"><span class="inline-block h-0.5 w-8 bg-signal"></span><%= t("events.bracket.legend.advance") %></li>
  <li class="flex items-center gap-2"><span class="inline-block w-8 border-t-2 border-dashed border-white/30"></span><%= t("events.bracket.legend.drop") %></li>
  <li class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-sm bg-signal/30"></span><%= t("events.bracket.legend.highlight") %></li>
  <li class="flex items-center gap-2"><span class="rounded bg-white/10 px-1 text-[10px] font-semibold text-white/70"><%= t("events.bracket.trial_rank_short", rank: 1) %></span><%= t("events.bracket.legend.trial") %></li>
  <li class="flex items-center gap-2"><span class="rounded bg-white/15 px-1 text-[10px] font-bold text-white">DNS</span><span class="rounded bg-white/15 px-1 text-[10px] font-bold text-white">DNF</span><span class="rounded bg-white/15 px-1 text-[10px] font-bold text-white">DEQ</span><%= t("events.bracket.legend.status") %></li>
</ul>
