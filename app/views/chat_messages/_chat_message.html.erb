<%# Ohne Bezug zum Betrachter, weil dieselbe Darstellung live an alle gesendet wird. %>
<li id="<%= dom_id(chat_message) %>" class="chat-msg" data-chat-target="message" data-author="<%= chat_message.user_id %>">
  <span class="chat-author mb-1 flex items-center gap-2 px-1 text-xs font-semibold text-white/60">
    <%= chat_message.user&.display_name || "–" %>
    <% if chat_message.user&.staff_role? %><span class="rounded bg-signal px-1.5 text-[10px] uppercase leading-4 text-white">Orga</span><% end %>
  </span>
  <div class="chat-bubble"><p class="whitespace-pre-wrap [overflow-wrap:anywhere]"><%= chat_body(chat_message.body) %></p></div>
  <span class="mt-1 flex items-center gap-3 px-1 text-[11px] text-white/40">
    <time datetime="<%= chat_message.created_at.iso8601 %>"><%= chat_message.created_at.strftime("%d.%m. %H:%M") %></time>
    <span class="hidden" data-delete>
      <%= button_to chat_room_message_path(chat_message.chat_room_id, chat_message), method: :delete, class: "cursor-pointer hover:text-white", form: { data: { action: "submit->chat#confirmDelete" } } do %>
        <%= app_icon :close, "h-3.5 w-3.5" %><span class="sr-only">×</span>
      <% end %>
    </span>
  </span>
</li>
