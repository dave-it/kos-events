<p class="eyebrow"><%= t("admin.users.roles.#{current_user.role}") %> · <%= current_user.display_name %></p>
<h1 class="mt-1 font-display text-5xl uppercase leading-none"><%= t(".title") %></h1>
<p class="mt-3 text-white/70"><%= t(".intro") %></p>

<h2 class="eyebrow mt-8"><%= t(".upcoming") %></h2>
<% if @upcoming.empty? %><p class="mt-2 text-white/60"><%= t(".none") %></p><% end %>
<ul class="mt-3 space-y-2">
  <% @upcoming.each do |event| %>
    <li><%= link_to event_path(event), class: "card block hover:bg-white/10" do %>
      <span class="font-semibold"><%= event.name %></span>
      <span class="block text-sm text-white/50"><%= l(event.starts_at.to_date) %> · <%= event.location %></span>
    <% end %></li>
  <% end %>
</ul>

<h2 class="eyebrow mt-6"><%= t(".results") %></h2>
<ul class="mt-3 space-y-2">
  <% @recent.each do |event| %>
    <li><%= link_to event_path(event), class: "card block !py-3 hover:bg-white/10" do %>
      <span class="font-semibold"><%= event.name %></span>
      <span class="block text-sm text-white/50"><%= l(event.starts_at.to_date) %> · <%= event.location %></span>
    <% end %></li>
  <% end %>
</ul>
<%= link_to t(".all_events"), events_path, class: "mt-4 inline-block underline underline-offset-4" %>
<div class="mt-8"><%= render "shared/install" %></div>
<%= button_to t("shared.sign_out"), session_path, method: :delete, class: "btn-ghost mt-4 w-full", form_class: "block" %>
