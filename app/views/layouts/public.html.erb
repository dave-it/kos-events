<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "Ice Cross Austria" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Mach mit beim schnellsten Sport auf Eislaufschuhen: Ice Cross in Österreich." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-ink text-white antialiased">
    <header class="sticky top-0 z-30 bg-ink/95 backdrop-blur border-b border-white/10">
      <nav class="mx-auto max-w-7xl px-5 h-16 flex items-center justify-between gap-6">
        <%= link_to root_path, class: "shrink-0", "aria-label": "Ice Cross Austria – Startseite" do %>
          <%= image_tag "landing/logo-white.png", alt: "Ice Cross Austria", class: "h-9 w-auto" %>
        <% end %>
        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-white/80">
          <a href="#event" class="hover:text-white">Nächstes Event</a>
          <a href="#mitmachen" class="hover:text-white">Mitmachen</a>
          <a href="#sport" class="hover:text-white">Der Sport</a>
          <a href="#galerie" class="hover:text-white">Galerie</a>
        </div>
        <% if current_user %>
          <%= link_to "Zu meinem Bereich", start_path, class: "rounded bg-signal hover:bg-signal-dark px-4 py-2 text-sm font-semibold" %>
        <% else %>
          <%= link_to "Fahrer-Login", new_session_path, class: "rounded bg-signal hover:bg-signal-dark px-4 py-2 text-sm font-semibold" %>
        <% end %>
      </nav>
    </header>

    <%= yield %>

    <footer class="border-t border-white/10 bg-ink">
      <div class="mx-auto max-w-7xl px-5 py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-white/60">
        <%= image_tag "landing/logo-white.png", alt: "Ice Cross Austria", class: "h-8 w-auto self-start" %>
        <p>© <%= Date.current.year %> Österreichischer Skate Cross Verband</p>
      </div>
    </footer>
  </body>
</html>
