<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("public.site_title") %></title>
    <meta name="description" content="<%= content_for(:description) || t("public.meta_description") %>">
    <%= render "shared/head" %>
  </head>

  <body class="bg-ink text-white antialiased">
    <% nav_links = [ [ t("public.nav.event"), root_path(anchor: "event") ], [ t("public.nav.sport"), root_path(anchor: "sport") ] ] +
                     Page.in_nav("header").map { |page| [ page.title, content_page_path(page.slug) ] } +
                     [ [ t("public.nav.results"), events_path ] ] %>
    <header class="sticky top-0 z-30 border-b border-white/10 bg-ink/95 pt-[env(safe-area-inset-top)] backdrop-blur">
      <nav class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 md:gap-6 md:px-5">
        <%= link_to root_path, class: "shrink-0", "aria-label": t("public.home_aria") do %>
          <%= image_tag "landing/logo-white.png", alt: t("public.brand"), class: "h-8 w-auto md:h-9" %>
        <% end %>
        <div class="hidden items-center gap-8 text-sm font-medium text-white/80 md:flex">
          <% nav_links.each do |label, path| %><%= link_to label, path, class: "hover:text-white" %><% end %>
        </div>
        <div class="flex items-center gap-2 md:gap-6">
          <div class="hidden md:block"><%= render "shared/locale_switcher" %></div>
          <% if current_user %>
            <%= link_to safe_join([ tag.span(t("public.nav.my_area_short"), class: "md:hidden"), tag.span(t("public.nav.my_area"), class: "hidden md:inline") ]), start_path, class: "rounded-lg bg-signal px-3 py-2 text-sm font-semibold whitespace-nowrap hover:bg-signal-dark" %>
          <% else %>
            <%= link_to t("public.nav.login"), new_session_path, class: "rounded-lg bg-signal px-3 py-2 text-sm font-semibold whitespace-nowrap hover:bg-signal-dark" %>
          <% end %>
          <details class="md:hidden">
            <summary class="cursor-pointer p-1.5" aria-label="<%= t("public.nav.menu") %>"><%= app_icon :menu %></summary>
            <div class="absolute inset-x-0 top-16 border-b border-white/10 bg-ink px-4 py-3 shadow-2xl">
              <% nav_links.each do |label, path| %><%= link_to label, path, class: "block border-b border-white/5 py-3 font-semibold" %><% end %>
              <div class="flex justify-start py-3"><%= render "shared/locale_switcher" %></div>
              <%= render "shared/install" %>
            </div>
          </details>
        </div>
      </nav>
    </header>

    <%= yield %>

    <footer class="border-t border-white/10 bg-ink">
      <div class="mx-auto max-w-7xl px-5 pt-10 pb-[max(2.5rem,env(safe-area-inset-bottom))] flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-white/60">
        <%= image_tag "landing/logo-white.png", alt: t("public.brand"), class: "h-8 w-auto self-start" %>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          <% Page.in_nav("footer").each do |page| %>
            <li><%= link_to page.title, content_page_path(page.slug), class: "hover:text-white" %></li>
          <% end %>
          <li><a href="https://www.instagram.com/oescv/" rel="noopener" target="_blank" class="hover:text-white">Instagram</a></li>
          <li><a href="https://www.facebook.com/oescv" rel="noopener" target="_blank" class="hover:text-white">Facebook</a></li>
          <li><a href="mailto:info@ice-cross.at" class="hover:text-white">info@ice-cross.at</a></li>
        </ul>
        <p>© <%= Date.current.year %> <%= t("public.footer_org") %></p>
      </div>
    </footer>
    <%= render "shared/cookie_notice" %>
  </body>
</html>
