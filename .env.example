# Kopie als .env auf dem Server (chmod 600). Nie committen.
RAILS_MASTER_KEY=
KOS_EVENTS_DATABASE_PASSWORD=
APP_HOST=devel.ice-cross.at
# Zusätzliche Domains, kommagetrennt (beim Umschalten: www.ice-cross.at,devel.ice-cross.at)
APP_EXTRA_HOSTS=

# Mailversand über IONOS. Ohne SMTP_PASSWORD werden keine Mails verschickt.
MAIL_FROM=no-reply@ice-cross.at
SMTP_ADDRESS=smtp.ionos.de
SMTP_PORT=587
SMTP_USERNAME=no-reply@ice-cross.at
SMTP_PASSWORD=
