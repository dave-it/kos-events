#!/usr/bin/env bash
# Deployt den aktuellen Git-Stand (HEAD) nach sirius. Baut auf dem Server.
# Voraussetzung: ~/kos-events/.env auf dem Server (siehe .env.example).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "Uncommitted changes: only committed code is deployed." >&2
fi

echo "==> Upload $(git rev-parse --short HEAD)"
ssh sirius 'mkdir -p ~/kos-events'
git archive HEAD | ssh sirius 'tar -x -C ~/kos-events'

echo "==> Build + start"
# Der Dockerfile-Frontend-Container (# syntax=...) startet auf sirius (OpenVZ) nicht zuverlässig.
# Der eingebaute Frontend reicht, daher die Zeile nur auf dem Server entfernen.
ssh sirius "sed -i '/^# syntax=/d' ~/kos-events/Dockerfile"
built=0
for attempt in 1 2 3 4 5; do
  if ssh sirius 'cd ~/kos-events && docker compose build'; then built=1; break; fi
  echo "Build failed (attempt $attempt), retrying..." >&2
  sleep 10
done
[ "$built" = 1 ] || { echo "Build failed, nothing changed." >&2; exit 1; }
# Auf sirius (OpenVZ) scheitert das Container-Netzwerk gelegentlich mit "iptables: Memory allocation problem".
# Ein erneuter Start hilft in der Regel.
for attempt in 1 2 3 4; do
  ssh sirius 'cd ~/kos-events && docker compose up -d' && break
  echo "Start failed (attempt $attempt), retrying..." >&2
  sleep 5
done
ssh sirius 'docker image prune -f >/dev/null' 

echo "==> Health"
for i in $(seq 1 30); do
  if ssh sirius 'curl -fs -o /dev/null http://127.0.0.1:3012/up'; then echo "OK"; exit 0; fi
  sleep 3
done
echo "App did not become healthy" >&2
ssh sirius 'cd ~/kos-events && docker compose logs --tail 40 web' >&2
exit 1
